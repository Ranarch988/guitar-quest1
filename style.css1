*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#111827;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    overflow:hidden;
    font-family:Arial, Helvetica, sans-serif;
}

canvas{
    border:4px solid white;
    image-rendering:pixelated;
}
